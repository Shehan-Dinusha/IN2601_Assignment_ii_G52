{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "Build OpenGL Project",
      "command": "g++",
      "args": [
        "-g",
        "-std=c++17",
        "-I${workspaceFolder}/include",
        "-I${workspaceFolder}/vendor/glad",
        "-I${workspaceFolder}/vendor/glfw",
        "-I${workspaceFolder}/vendor/imgui",
        "-L${workspaceFolder}/lib",
        "${workspaceFolder}/src/*.cpp",
        "${workspaceFolder}/vendor/glad/glad.c",
        "${workspaceFolder}/vendor/imgui/*.cpp",
        "-lglfw3dll",
        "-lfreeglut",
        "-lopengl32",
        "-lglu32",
        "-o",
        "${workspaceFolder}/app.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compiler: g++"
    }
  ]
}
